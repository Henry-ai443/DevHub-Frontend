# Frontend Environment Configuration
# Copy this file to .env.local and update with your values

# API Configuration
VITE_API_URL=http://localhost:5000/api

# Optional: Production API URL (uncomment when deploying)
# VITE_API_URL=https://api.yourdomain.com/api

# App Name
VITE_APP_NAME=DevHub

# App Version
VITE_APP_VERSION=1.0.0

# Environment
VITE_ENV=development

# Features (enable/disable features)
VITE_ENABLE_ANALYTICS=false
VITE_ENABLE_MESSAGING=true
VITE_ENABLE_PROJECTS=true
VITE_ENABLE_HIRING=true

# Session Configuration
VITE_SESSION_TIMEOUT=1800000

# Image Settings
VITE_MAX_IMAGE_SIZE=5242880
VITE_ALLOWED_IMAGE_TYPES=image/jpeg,image/png,image/webp

# Pagination
VITE_ITEMS_PER_PAGE=10
VITE_MAX_ITEMS_PER_PAGE=100
